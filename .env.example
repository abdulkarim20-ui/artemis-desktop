# Copy to .env and fill in your keys. At least one provider is required.
GROQ_API_KEY=
NVIDIA_API_KEY=

# Local agent port (default 3000). Change it if something else already uses
# 3000; Electron and `npm run agent` both read this value.
ARTEMIS_PORT=3000

# Optional model for voice transcription (default: whisper-large-v3-turbo).
GROQ_STT_MODEL=

# Optional: cap Groq completion tokens (default 1000).
GROQ_MAX_COMPLETION_TOKENS=4096

# ---------------------------------------------------------------------------
# KNOWLEDGE BASE (retrieval over attached code, PDFs and documents)
# ---------------------------------------------------------------------------
#
# PRIVACY - READ THIS BEFORE INDEXING ANYTHING.
#
# Conversion and chunking happen locally, but embedding does not. Indexing a
# file sends its text chunks to NVIDIA's hosted endpoint
# (integrate.api.nvidia.com) to be turned into vectors, and every question is
# sent there too. NVIDIA_API_KEY is what makes that call, and the same key also
# drives chat - so setting it enables retrieval as well.
#
# Leave retrieval off by setting ARTEMIS_RAG_DISABLED=1 below. Chat keeps
# working exactly as before; attachments still reach the model inline through
# <attached_files>, they just are not indexed or searched.
#
# There is no offline embedding model bundled. Making retrieval local would
# mean pointing config/embeddings.json at a self-hosted endpoint that serves the
# same OpenAI-compatible /embeddings shape.

# Reuses the chat key above. Retrieval reports "not configured" without it and
# the chat view silently carries on with no knowledge base.
# (No separate variable - see ai-agent/config/embeddings.json, apiKeyEnv.)

# Set to 1/true/yes to switch retrieval off completely. Read once when the agent
# starts, so changing it needs an app restart.
ARTEMIS_RAG_DISABLED=

# Where the index is written. Normally leave this empty:
#   - under Electron, main/ai-server.js injects ARTEMIS_DATA_DIR (the app's
#     userData directory), and the index goes to <userData>/rag. A packaged app
#     cannot write inside its own install directory, so this is not optional.
#   - running the agent on its own (`npm run agent` from the repository root), it falls back to
#     ai-agent/.data/rag, which is git-ignored.
# Setting ARTEMIS_RAG_DIR overrides both. Note that .env is loaded with
# override:false, so Electron-injected values win over what is written here.
#
# The index holds your document text and its vectors. Point it somewhere you
# back up if you want the knowledge base to survive a reinstall.
ARTEMIS_RAG_DIR=
