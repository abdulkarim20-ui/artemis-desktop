{
  "name": "artemis",
  "version": "1.0.0",
  "private": true,
  "description": "Artemis: a local-first AI chat desktop app with a custom title bar and sidebar",
  "author": "Abdulkarim",
  "license": "MIT",
  "productName": "Artemis",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "agent": "node --disable-warning=DEP0040 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ai-agent/server.js",
    "agent:dev": "node --disable-warning=DEP0040 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --watch ai-agent/server.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=20.19"
  },
  "build": {
    "appId": "com.artemis.app",
    "productName": "Artemis",
    "copyright": "Copyright © 2026 Abdulkarim",
    "directories": {
      "buildResources": "assets/brand"
    },
    "files": [
      "!**/.env",
      "!**/.env.*",
      "!**/*.log",
      "!tests/**/*"
    ],
    "win": {
      "icon": "icon.ico"
    },
    "linux": {
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.2.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "openai": "^7.10.0"
  },
  "allowScripts": {
    "electron@45.3.2": true
  }
}
